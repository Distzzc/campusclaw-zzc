SECRET_KEY=replace-with-a-long-random-server-secret
FLASK_ENV=development
APP_PORT=5000
# Explicitly prepare models with scripts/prepare_models.py before enabling Q&A.
EMBEDDING_MODEL_PATH=data/models/embedding
EMBEDDING_MODEL_REVISION=local-v1
QA_MODEL_PATH=data/models/qa
KNOWLEDGE_ENABLED=true
TUTORING_ENABLED=true
QA_PROVIDER=auto
QA_API_BASE_URL=https://your-openai-compatible-gateway/v1
QA_API_KEY=replace-with-your-model-api-key
QA_API_MODEL=your-chat-model
QA_API_TIMEOUT=45

# Optional integrations. External service secrets must be environment variables.
TOOLS_ENABLED=true
TOOLS_CONFIG_PATH=config/integrations.json
TOOLS_TIMEOUT=10
MCP_SERVER_ENABLED=true
# Add your deployed hostname/origin before exposing MCP beyond localhost.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*,mcp-server,mcp-server:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
